{
  "name": "compare",
  "version": "1.2.0",
  "description": "Side-by-side comparison of two texts or documents",
  "author": "mikep49",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win zip --x64 -c.win.signAndEditExecutable=false",
    "dist:installer": "electron-builder --win nsis portable --x64"
  },
  "build": {
    "appId": "io.github.mikep49.compare",
    "productName": "Compare",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@napi-rs/**"
    ],
    "win": {
      "icon": "src/icon.png"
    },
    "nsis": {
      "artifactName": "Compare-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Compare-Portable-${version}.${ext}"
    },
    "artifactName": "Compare-${version}-win-x64.${ext}"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "docx-preview": "^0.4.1",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^44.10.2",
    "electron-builder": "^26.15.3"
  }
}
